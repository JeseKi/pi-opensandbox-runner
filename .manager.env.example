# Runner Manager is private. Set every secret below; never commit real values.
# The service and admin tokens must be different.
OPENSANDBOX_API_KEY=
LITELLM_MASTER_KEY=
RUNNER_MANAGER_CREDENTIAL_ENCRYPTION_KEY=
RUNNER_MANAGER_BOOTSTRAP_SERVICE_TOKEN=
RUNNER_MANAGER_BOOTSTRAP_ADMIN_TOKEN=

RUNNER_MANAGER_BOOTSTRAP_CONSUMER=agent-runner
PI_RUNNER_IMAGE=pi-opensandbox-runner:local

# Browser-facing WebTerminal gateway. Production must use wss:// and an exact
# comma-separated Origin allowlist. The values below are local-demo defaults.
RUNNER_MANAGER_TERMINAL_PUBLIC_WS_URL=ws://127.0.0.1:8090/v1/terminal-connections
RUNNER_MANAGER_TERMINAL_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RUNNER_MANAGER_TERMINAL_TICKET_TTL_SECONDS=60
RUNNER_MANAGER_TERMINAL_DETACHED_TTL_SECONDS=900
RUNNER_MANAGER_TERMINAL_MAX_LIFETIME_SECONDS=28800
RUNNER_MANAGER_MAX_TERMINALS_PER_INSTANCE=4

# MkDocs 静态构建产物目录。Manager 在 /mkdocs/docs 提供该目录。
RUNNER_MANAGER_DOCS_SITE_DIR=site
