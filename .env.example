# Copy this file to .env, uncomment only the provider settings you use, then run:
#   ./scripts/up.sh NAME --env-file .env --provider PROVIDER --model MODEL
#
# This file is injected into the sandbox. Do not put BRIDGE_API_TOKEN here:
# scripts/up.sh generates and stores that token in .runtime/NAME.json.

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# OpenAI and OpenAI-compatible providers
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Google Gemini
# GEMINI_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# xAI
# XAI_API_KEY=

# Groq
# GROQ_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_SESSION_TOKEN=

# Optional Pi behavior
# PI_TELEMETRY=0
# PI_OFFLINE=0

# Remote MCP credentials. MCP Server API configurations may reference only MCP_* variables,
# for example: "Authorization": "Bearer ${MCP_CONTEXT7_TOKEN}".
# MCP_CONTEXT7_TOKEN=
# MCP_GITHUB_TOKEN=
#
# HTTPS MCP URLs are required by default. Enable only for trusted internal development servers:
# MCP_ALLOW_INSECURE_HTTP=1
