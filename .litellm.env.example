# Copy to .litellm.env and chmod 600 .litellm.env.
# This file is read by the LiteLLM container only; it is never injected into a sandbox.
LITELLM_MASTER_KEY=replace-with-a-random-long-secret

# Provider credentials are only available to LiteLLM, never to sandboxes.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
